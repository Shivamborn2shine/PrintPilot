# Runtime SQLite database, WAL/SHM locks, per-install secrets, and private PDF vault
data/
data.backup-*/
*.db
*.db-wal
*.db-shm

# Temporary OS & scratch files
Thumbs.db
.DS_Store
*.png
*.jpg

# Environment variables and secrets
.env
.env.*
!.env.example
config/*.local.json
# Per-machine shop identity: created by the first-run setup wizard, never committed.
# (A committed station.json makes every fresh install impersonate that shop.)
config/station.json
config/station.json.*
config/station-*.json
!config/station.example.json
secrets/

# Crash / startup logs written next to the executable
startup_error.log
crash.log

# Tunnel binary
bin/cloudflared.exe
bin/*.yml

# Root binary & station profile downloads
/PrintAway.exe
station-*.json

# Distribution packaging & updater temporary files
dist/
*.update
*.pending
apply-update.bat
