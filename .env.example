# PrintAway Station - optional environment overrides (copy to .env; .env is git-ignored)
# Nothing here is required: a fresh install runs the setup wizard and generates its own
# per-install secrets in data/secrets.json.

# Razorpay API credentials (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay webhook secret (https://dashboard.razorpay.com/app/webhooks)
RAZORPAY_WEBHOOK_SECRET=

# Internal station secrets. Leave empty to use the random per-install values in data/secrets.json.
PRINTAWAY_WEBHOOK_SECRET=
PRINTAWAY_WORKER_TOKEN=

# Platform-owner override login for the counter dashboard. DISABLED unless set here
# (minimum 16 characters). Never commit a real value.
PRINTAWAY_MASTER_PASSWORD=

# SaaS control plane (Supabase). Defaults to the hosted PrintAway project.
# Only ever use a publishable/anon key on station PCs - never the service-role key.
SUPABASE_URL=
SUPABASE_KEY=
