# PrintAway Environment Variables & Secrets (Ignored by Git)

# Razorpay API Credentials (from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# Razorpay Webhook Secret (configured in https://dashboard.razorpay.com/app/webhooks)
RAZORPAY_WEBHOOK_SECRET=PrintAwayRazorpayWebhook2026!

# Internal Station & Worker Secrets (Optional overrides)
PRINTAWAY_WEBHOOK_SECRET=pa_local_webhook_secret_2026
PRINTAWAY_WORKER_TOKEN=pa_local_worker_token_2026

# Supabase SaaS Control Plane
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here

